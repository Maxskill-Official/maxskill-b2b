# Google Sheets — 프로젝트 목록 (CSV 공개 URL)
# 시트: 파일 → 공유 → 웹에 게시 → CSV → URL 복사
GOOGLE_SHEETS_PROJECTS_CSV_URL=

# Google Sheets — 채용 공고 탭 (CSV 공개 URL)
GOOGLE_SHEETS_CAREERS_CSV_URL=

# Neon PostgreSQL — 홈페이지 로그인 및 채용공고
DATABASE_URL=

# 32자 이상의 무작위 문자열 (예: openssl rand -base64 48)
AUTH_SECRET=

# 아래 값은 사내 PC에서 직원 계정을 1회 이전할 때만 사용합니다.
# Vercel 환경변수에는 등록하지 않습니다.
SOURCE_SQL_SERVER=
SOURCE_SQL_DATABASE=PJ_OT_DB
SOURCE_SQL_USER=
SOURCE_SQL_PASSWORD=

